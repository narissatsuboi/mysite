---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length >= 3 && (
  <nav aria-label="Table of contents" class="not-prose mt-6">
    <p class="mb-2 font-mono text-xs uppercase text-muted-foreground/70">Table of contents</p>
    <ul class="space-y-1 text-sm">
      {items.map((h) => (
        <li class:list={{ "pl-4": h.depth === 3 }}>
          <a href={`#${h.slug}`} class="text-muted-foreground hover:text-foreground hover:underline">
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
