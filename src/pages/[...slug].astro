---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import { getAllPages, getPageSlugPath } from "@/utils/content";
import { formatDate } from "@/utils/text";

export async function getStaticPaths() {
  const pages = await getAllPages();

  return pages.map((page) => ({
    params: { slug: getPageSlugPath(page.id, page.filePath) },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const posted = page.data.posted ? formatDate(page.data.posted) : undefined;
---

<BaseLayout title={page.data.title}>
  <div class="layout-content">
    <PageHeader title={page.data.title} />

    <article data-pagefind-body class="markdown-content py-8">
      <meta data-pagefind-meta="title[content]" content={page.data.title} />
      <meta data-pagefind-sort="date[content]" content={page.data.updated?.toISOString()} />
      {posted && (
        <p class="not-prose -mt-2 mb-6 font-mono text-xs uppercase text-muted-foreground">
          Posted on <time datetime={page.data.posted!.toISOString()}>{posted}</time>
        </p>
      )}
      <Content />
    </article>
  </div>
</BaseLayout>
